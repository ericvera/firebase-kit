{
  "name": "firebase-kit-protocol",
  "version": "2.0.0",
  "description": "Shared callable-function contract for firebase-kit: request and response types, API versioning, and the error codes that cross the wire.",
  "keywords": [
    "firebase",
    "firebase-kit",
    "cloud-functions",
    "callable",
    "protocol",
    "types",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "!/**/__test__",
    "!*.test.*"
  ],
  "scripts": {
    "build": "tsc --build",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.8",
    "eslint": "^10.8.1",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ericvera/firebase-kit.git",
    "directory": "packages/firebase-kit-protocol"
  },
  "publishConfig": {
    "access": "public"
  }
}
