{
  "name": "firebase-kit-client",
  "version": "3.0.0",
  "description": "Client-side Firebase toolkit: typed callable functions including fire-and-forget keepalive callables, Firestore helpers, connectivity handling, rate limiting, and test mocks.",
  "keywords": [
    "firebase",
    "firebase-kit",
    "firestore",
    "cloud-functions",
    "callable",
    "keepalive",
    "client",
    "connectivity",
    "rate-limit",
    "testing",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./callable": "./dist/callable/index.js",
    "./connectivity": "./dist/connectivity/index.js",
    "./firestore": "./dist/firestore/index.js",
    "./mocks": "./dist/mocks/index.js",
    "./rate-limit": "./dist/rate-limit/index.js",
    "./runtime": "./dist/runtime/index.js",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "!/**/__test__",
    "!/**/__mocks__",
    "!*.test.*"
  ],
  "scripts": {
    "build": "tsc --build",
    "lint": "eslint .",
    "test": "yarn test-unit",
    "test-unit": "tsc --build && vitest run --project=unit"
  },
  "dependencies": {
    "firebase-kit-protocol": "workspace:*"
  },
  "peerDependencies": {
    "firebase": "^12.18.0",
    "getsetdel": "^3.0.0",
    "vitest": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^24.13.4",
    "eslint": "^10.10.0",
    "firebase": "^12.19.0",
    "getsetdel": "^3.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ericvera/firebase-kit.git",
    "directory": "packages/firebase-kit-client"
  },
  "publishConfig": {
    "access": "public"
  }
}
