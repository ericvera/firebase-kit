{
  "name": "firebase-kit-admin",
  "version": "1.0.0",
  "description": "Firebase Admin SDK toolkit: callable functions, Firestore transactions, auth checks, task queues, request validation, and emulator testing.",
  "keywords": [
    "firebase",
    "firebase-kit",
    "firebase-admin",
    "firestore",
    "cloud-functions",
    "callable",
    "auth",
    "task-queue",
    "validation",
    "emulator",
    "testing",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./auth": "./dist/auth/index.js",
    "./callable": "./dist/callable/index.js",
    "./errors": "./dist/errors/index.js",
    "./firestore": "./dist/firestore/index.js",
    "./mocks": "./dist/mocks/index.js",
    "./runtime": "./dist/runtime/index.js",
    "./tasks": "./dist/tasks/index.js",
    "./testing": "./dist/testing/index.js",
    "./validation": "./dist/validation/index.js",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "!/**/__test__",
    "!/**/__mocks__",
    "!*.test.*"
  ],
  "scripts": {
    "build": "tsc --build",
    "lint": "eslint .",
    "test": "yarn test-unit && yarn test-emulator",
    "test-unit": "tsc --build && vitest run --project=unit",
    "test-emulator": "tsc --build && firebase emulators:exec --project demo-admin-tests --only auth,firestore \"TZ=Etc/Universal vitest run --project=emulator\""
  },
  "dependencies": {
    "firebase-kit-protocol": "workspace:*",
    "jest-diff": "^30.4.1"
  },
  "peerDependencies": {
    "betterbe": "^4.1.0",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "vitest": "^4.1.10"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^24.13.3",
    "betterbe": "^4.1.0",
    "eslint": "^10.8.1",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "firebase-tools": "15.26.0",
    "scdate-testing": "^7.1.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ericvera/firebase-kit.git",
    "directory": "packages/firebase-kit-admin"
  },
  "publishConfig": {
    "access": "public"
  }
}
