{
  "name": "@firebase-kit/monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write .",
    "-- LINT: builds first, so typed linting can resolve a package's dependency on another package's `dist` on a clean checkout --": "",
    "lint": "yarn build && eslint .",
    "-- LINT-CHANGED: what lint-staged runs; same build-first reason, and lint-staged appends the staged files to it --": "",
    "lint-changed": "yarn build && eslint --cache",
    "build": "tsc --build",
    "-- TESTS: one runner invocation per package; package script names must stay colon-free (Yarn treats a colon script defined by exactly one workspace as global, so foreach would run it once per workspace) --": "",
    "test": "yarn test:unit && yarn test:emulator",
    "test:unit": "yarn build && yarn workspaces foreach --all --exclude @firebase-kit/monorepo run test-unit",
    "test:emulator": "yarn build && yarn workspaces foreach --all --exclude @firebase-kit/monorepo run test-emulator",
    "-- PRE-COMMIT HOOKS --": "",
    "localAfterInstall": "husky || true"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.0",
    "firebase-tools": "15.26.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "prettier": {
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ericvera/firebase-kit.git"
  },
  "license": "MIT",
  "lint-staged": {
    "*.{ts,tsx,mjs}": "yarn lint-changed",
    "*": "prettier --ignore-unknown --write"
  },
  "packageManager": "yarn@4.18.0"
}
